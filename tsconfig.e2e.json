{
  // E2E (Playwright) はワークスペースのどれにも属さないので、ここで型を見る。
  // ブラウザ側で動く evaluate のコールバックがあるため DOM の型も要る。
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "types": ["node"],
    // 偽 GitHub は Node が直接実行する (型注釈は実行時に落ちる)。Node の解決には
    // 拡張子付きの相対 import が要るので、それを型検査にも許す。
    "allowImportingTsExtensions": true
  },
  "include": ["e2e", "playwright.config.ts"]
}
