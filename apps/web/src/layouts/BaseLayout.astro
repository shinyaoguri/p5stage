---
interface Props {
  title: string;
  description?: string;
  /**
   * 検索エンジンに載せない。
   *
   * 限定公開の作品ページで立てる。「URL を知る人だけが見られる」という約束は、
   * 検索結果に出た時点で崩れる (要件 3.4)。
   */
  noindex?: boolean;
  /** 同じ内容に複数の URL があるページで、正とみなす URL。 */
  canonical?: string;
  /**
   * 共有したときにカードへ出す絵の絶対 URL (Phase 4-4)。
   *
   * 無ければ `og:image` ごと出さない。**存在しない画像を指すより、絵の無いカードの
   * 方がまし**で、SNS 側は画像が引けないと本文まで出さないことがある。
   */
  image?: string;
}

const {
  title,
  description = "p5.js スケッチの開発・共有プラットフォーム",
  noindex = false,
  canonical,
  image,
} = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {canonical !== undefined && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {
      image !== undefined && (
        <Fragment>
          <meta property="og:image" content={image} />
          {/* 絵があるときだけ大きいカードにする。無いのに宣言すると、
              画像の入る場所が空いたままのカードになる */}
          <meta name="twitter:card" content="summary_large_image" />
        </Fragment>
      )
    }
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;
    --bg: #ffffff;
    --fg: #16161a;
    --muted: #6b6b76;
    --accent: #e5457b;
    /* 文章を読ませる面の書体。エディタ画面は操作系だけを等幅にする
       (`--ui-font-family` / styles/editor-chrome.css) ので、そこから戻す先として
       変数で持つ。 */
    --body-font-family:
      system-ui, -apple-system, "Hiragino Sans", "Noto Sans JP", sans-serif;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #16161a;
      --fg: #f2f2f5;
      --muted: #9a9aa6;
    }
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    min-height: 100dvh;
    background: var(--bg);
    color: var(--fg);
    font-family: var(--body-font-family);
    line-height: 1.7;
  }
</style>
