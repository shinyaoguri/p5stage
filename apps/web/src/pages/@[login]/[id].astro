---
/**
 * 作品ページ (Phase 2-4)。閲覧にログインは要らない (要件 3.4)。
 *
 * 正典 URL は `/@<login>/<sketchId>`。引く鍵は sketchId だけで、**login は表示の
 * ための飾り**。違っていれば正典へ 302 する (`users.login` は改名で変わるため。
 * Gist は同じ形で 404 になるが、こちらはそうならない — ADR 0011)。
 *
 * 中身は D1 のポインタ → R2 の不変オブジェクトで解決する。閲覧が GitHub を
 * 叩かないので、レート制限が閲覧数に比例しない。
 */
import {
  OriginConfigError,
  resolveOrigins,
  thumbnailPath,
} from "@p5stage/shared";
import { env } from "cloudflare:workers";

import BaseLayout from "../../layouts/BaseLayout.astro";
import { configuredAssetsOrigin } from "../../lib/assets/delivery-origin";
import {
  initialFileName,
  isCanonicalLogin,
  orderedFileNames,
  sketchPath,
  sketchRevisionPath,
  tagPath,
  userPath,
} from "../../lib/sketches/content";
import {
  resolveRevisionContent,
  resolveSketchContent,
} from "../../lib/sketches/delivery";
import { isSketchId } from "../../lib/sketches/id";
import { listRevisions } from "../../lib/sketches/revision-log";
import {
  listableGistId,
  planRevisionView,
  REVISION_LIST_LIMIT,
} from "../../lib/sketches/revision-view";
import {
  getSketchWithOwner,
  listTagsForSketch,
} from "../../lib/sketches/store";

export const prerender = false;

const login = Astro.params.login ?? "";
const id = Astro.params.id ?? "";

// 形が違う値を D1 まで持って行かない。存在の確認ではなく足切り。
const sketch = isSketchId(id) ? await getSketchWithOwner(env.DB, id) : null;

// 見つからないときも、他人のものだったときも同じ 404 (存在を漏らさない)。
// **404 は共有キャッシュに載せない** — 載せると、当てずっぽうの `?rev=` を
// 投げ続ける相手にとって空振りが安くなる。
if (sketch === null) {
  return new Response(null, {
    status: 404,
    headers: { "Cache-Control": "no-store" },
  });
}

// どの版を出すかは純ロジックが決める (Phase 4-1 / ADR 0016)。
const view = planRevisionView(sketch, Astro.url.searchParams.get("rev"));
if (view.kind === "unknown") {
  return new Response(null, {
    status: 404,
    headers: { "Cache-Control": "no-store" },
  });
}

// 正典 URL は `<link rel="canonical">` の値。**過去の版でもクエリの無いこの URL を
// 指す** — 版は増え続けるので、検索エンジンに近似重複を並べない (ADR 0016)。
const canonicalUrl = new URL(
  sketchPath(sketch.ownerLogin, sketch.id),
  Astro.url.origin
).href;

if (!isCanonicalLogin(login, sketch.ownerLogin)) {
  // 飛び先で `?rev=` を落とさない。落とすと、古い login で貼られた版へのリンクが
  // 黙って最新にすり替わる。
  return Astro.redirect(
    new URL(
      view.kind === "past"
        ? sketchRevisionPath(sketch.ownerLogin, sketch.id, view.revision)
        : sketchPath(sketch.ownerLogin, sketch.id),
      Astro.url.origin
    ).href,
    302
  );
}

// 今の版を指す `?rev=` は正典へ寄せる (同じ中身に 2 つの URL を持たせない)。
if (view.kind === "canonical") {
  return Astro.redirect(canonicalUrl, 302);
}

const past =
  view.kind === "past"
    ? await resolveRevisionContent(view.gistId, view.revision)
    : null;

// 台帳に無い版は、存在しない作品と同じ扱いにする。
if (past !== null && past.kind === "unknown") {
  return new Response(null, {
    status: 404,
    headers: { "Cache-Control": "no-store" },
  });
}

// 今の版だけが再検証 (GitHub への確かめ直し) を伴う。過去の版は台帳と R2 で閉じる。
const content =
  past === null ? await resolveSketchContent(sketch, Date.now()) : null;

const files =
  past !== null
    ? past.kind === "ready"
      ? past.files
      : null
    : content !== null && content.kind === "ready"
      ? content.files
      : null;
const fileNames = files === null ? [] : orderedFileNames(files);
const activeFile = files === null ? null : initialFileName(files);

// 履歴は「p5stage が写しを持っている版」の一覧 (ADR 0016)。開けない版は並べない。
const historyGistId = listableGistId(sketch);
const revisions =
  historyGistId === null
    ? []
    : await listRevisions(env.DB, historyGistId, REVISION_LIST_LIMIT);

/**
 * 派生元 (Phase 4-3 / #44)。系譜の正典は D1 にある。
 *
 * **リンクを出すのは親が公開のときだけ。** 限定公開の親の URL を公開の子に出すと、
 * エッジキャッシュ越しに**その URL を知らない全員へ配られる**。`unlisted` は
 * 「URL を知る人は見られる」= URL が防御そのものなので (要件 3.4)、ここで漏らすと
 * 「fork しても公開範囲の意図しない昇格は起きない」(#44) の前提が崩れる。
 */
const parent =
  sketch.forkedFromSketchId === null
    ? null
    : await getSketchWithOwner(env.DB, sketch.forkedFromSketchId);

/**
 * タグ (Phase 5)。**限定公開の作品にも出す** — タグはこのページの中身の一部で、
 * 隠す理由は無い。タグ別の一覧に出ないこと (`listPublicSketchesByTag`) とは別の話。
 */
const tags = await listTagsForSketch(env.DB, sketch.id);

// 実行環境のオリジン (要件 5.1 / ADR 0007) とアセットの配信オリジン (ADR 0014)。
let previewOrigin: string | null = null;
let assetsOrigin: string | null = null;
let originError: string | null = null;
try {
  const origins = resolveOrigins({
    web: Astro.url.origin,
    preview: env.PUBLIC_PREVIEW_ORIGIN,
    assets: configuredAssetsOrigin(),
  });
  previewOrigin = origins.preview;
  assetsOrigin = origins.assets;
} catch (error) {
  if (!(error instanceof OriginConfigError)) throw error;
  originError = error.message;
}

// 限定公開の URL が共有キャッシュに載ると、ID を知らない相手にも届きうる。
// 公開作品はエッジに載せる — 閲覧が伸びても Worker まで来る回数が増えない。
Astro.response.headers.set(
  "Cache-Control",
  sketch.visibility === "public"
    ? "public, max-age=0, s-maxage=60"
    : "private, no-store"
);

const formatTime = (value: number): string =>
  new Date(value).toLocaleString("ja-JP", {
    year: "numeric",
    month: "numeric",
    day: "numeric",
    hour: "2-digit",
    minute: "2-digit",
  });

const updatedAt = formatTime(sketch.updatedAt);

// 過去の版を見ているなら、GitHub 側もその版を指す (Gist は `<id>/<sha>` で開ける)。
const gistUrl =
  sketch.gistId === null
    ? null
    : `https://gist.github.com/${sketch.ownerLogin}/${sketch.gistId}` +
      (past !== null && past.kind === "ready" ? `/${past.revision}` : "");

// 今画面に出ている版。閲覧側はこれを起点に「進んだかどうか」を見る (Phase 4-2)。
const shownRevision =
  past !== null
    ? past.kind === "ready"
      ? past.revision
      : null
    : content !== null && content.kind === "ready"
      ? content.revision
      : null;

/**
 * 作者の保存に追従するか (Phase 4-2 / ADR 0017)。
 *
 * 追従するのは**最新の版を、中身が出ている状態で見ているとき**だけ。
 *
 * - 過去の版を開いている閲覧者を勝手に最新へ動かさない (`?rev=` を指定した意味が消える)
 * - 中身が出ていない作品 (未保存・削除済み・取得不能) には差し替える先の DOM が無い。
 *   保存された後の姿は、開き直せば出る
 */
const live = past === null && files !== null;

/**
 * 共有したときのカードに出す絵 (Phase 4-4 / ADR 0019)。
 *
 * 出すのは**最新の版を見ているとき**だけ。過去の版のページは `noindex` で
 * 近似重複を並べない方針 (ADR 0016) なので、カードも作らない。
 *
 * 限定公開でも出す。「URL を知る人は見られる」ものを共有した先でカードが出るのは
 * 本来の用途で、画像の鍵は gist の ID とリビジョン SHA なので推測もできない
 * (ページ自体は今までどおり `noindex` / `private, no-store`)。
 */
const thumbnailUrl =
  past === null &&
  sketch.gistId !== null &&
  sketch.thumbnailRevision !== null &&
  assetsOrigin !== null
    ? new URL(
        thumbnailPath(sketch.gistId, sketch.thumbnailRevision),
        assetsOrigin
      ).href
    : undefined;

/** 中身が出せないときに、閲覧者へ見せる説明。 */
const notice = (() => {
  if (past !== null) {
    // 台帳にあるのに写しが読めない。埋め直せるのは今の版だけ (ADR 0016)。
    return past.kind === "gone" ? "この版の中身は残っていません。" : null;
  }
  // `past` と `content` は排他 (どちらか一方だけを解決する)。
  if (content === null) return null;

  switch (content.kind) {
    case "ready":
      return null;
    case "unsaved":
      return "この作品はまだ保存されていません。";
    case "deleted":
      return "この作品の元になった Gist は作者によって削除されました。";
    case "unavailable":
      return `いま中身を表示できません (${content.reason})。`;
  }
})();
---

<BaseLayout
  title={`${sketch.title} | p5stage`}
  description={sketch.description || `${sketch.ownerLogin} の p5.js スケッチ`}
  noindex={sketch.visibility === "unlisted" || past !== null}
  canonical={canonicalUrl}
  image={thumbnailUrl}
>
  <main
    class="sketch-page"
    data-preview-origin={previewOrigin}
    data-assets-origin={assetsOrigin}
    data-active-file={activeFile}
    data-sketch-id={sketch.id}
    data-owner-id={String(sketch.ownerId)}
    data-visibility={sketch.visibility}
    data-revision={shownRevision}
    data-past={past !== null ? "1" : undefined}
    data-live={live ? "1" : undefined}
  >
    <header class="sketch-header">
      <h1>{sketch.title}</h1>
      <p class="sketch-meta">
        <a class="sketch-author" href={userPath(sketch.ownerLogin)}>
          {
            sketch.ownerAvatarUrl !== null && (
              <img
                class="sketch-avatar"
                src={sketch.ownerAvatarUrl}
                alt=""
                width="24"
                height="24"
                loading="lazy"
              />
            )
          }
          {sketch.ownerLogin}
        </a>
        <span class="sketch-updated">更新 {updatedAt}</span>
        {
          gistUrl !== null && (
            <a href={gistUrl} target="_blank" rel="noopener noreferrer">
              Gist
            </a>
          )
        }
        {
          /* 追従できているときだけ出る。印を描くのは CSS で、条件は
            `data-live-state`(JS が書く)。繋がる前・切れた後・混雑で断られたときは
            出ない — **閲覧そのものは何も変わらない**ので、失敗を言い立てない */
        }
        {live && <span class="sketch-live">同期中</span>}
      </p>
      {
        sketch.description !== "" && (
          <p class="sketch-description">{sketch.description}</p>
        )
      }
      {
        tags.length > 0 && (
          <ul class="sketch-tags" aria-label="タグ">
            {tags.map((tag) => (
              <li>
                <a href={tagPath(tag)}>{tag}</a>
              </li>
            ))}
          </ul>
        )
      }
      {
        sketch.visibility === "unlisted" && (
          <p class="sketch-warning">
            限定公開 — この URL を知っている人は誰でも見られます
            (非公開ではありません)。
          </p>
        )
      }
      {
        past !== null && (
          <p class="sketch-past">
            過去の版を見ています
            {past.kind === "ready" && ` (${formatTime(past.createdAt)} の写し)`}
            。<a href={sketchPath(sketch.ownerLogin, sketch.id)}>最新の版へ</a>
          </p>
        )
      }
      {
        parent !== null && (
          <p class="sketch-lineage">
            {parent.visibility === "public" ? (
              <Fragment>
                <a href={sketchPath(parent.ownerLogin, parent.id)}>
                  {parent.title}
                </a>
                {` (${parent.ownerLogin}) から派生`}
              </Fragment>
            ) : (
              // 親の存在までは隠さない (子から辿れる事実なので) が、URL は出さない。
              "限定公開の作品から派生"
            )}
          </p>
        )
      }
      {
        /* ログインしている人にだけ出る操作 (#43 / Phase 4-3)。**中身は JS が足す** —
          ここで出し分けると、その人向けの HTML がエッジキャッシュ越しに他人へ配られる */
      }
      <div class="sketch-actions" id="sketch-actions"></div>
    </header>

    {
      originError !== null ? (
        <p class="sketch-notice">
          実行環境のオリジン設定が不正です: {originError}
        </p>
      ) : (
        notice !== null && <p class="sketch-notice">{notice}</p>
      )
    }

    {
      files !== null && originError === null && (
        <div class="sketch-stage" id="stage" />
      )
    }

    {
      files !== null && (
        <section class="sketch-code">
          <h2 class="sketch-code-heading">コード</h2>
          {/* タブは JS が作る。中身は最初から DOM にあるので、JS 無しでも読める */}
          <div class="sketch-tabs" id="sketch-tabs" />
          {/* 中身は set:text で 1 要素に閉じる。子要素を挟むと整形が要素の間に
              改行を入れ、その空白がコードの一部として実行にも回ってしまう。
              set:text は値をエスケープするので、他者のコードを埋めても安全。 */}
          {fileNames.map((name) => (
            <pre
              class="sketch-file"
              data-file={name}
              hidden={name !== activeFile}
              set:text={files[name]}
            />
          ))}
        </section>
      )
    }

    {/* 版が 1 つしか無い作品に「履歴」は要らない (保存した直後がその状態)。 */}
    {
      revisions.length > 1 && (
        <section class="sketch-history">
          <h2 class="sketch-history-heading">履歴</h2>
          <p class="sketch-history-note">
            p5stage が写しを持っている版です (Gist の全履歴ではありません)。
          </p>
          {/* ただのリンクなので JS 無しでも辿れる。 */}
          <ol class="sketch-history-list">
            {revisions.map((entry) => {
              const isCurrent = entry.revision === sketch.currentRevision;
              const viewing =
                past === null ? isCurrent : entry.revision === past.revision;
              return (
                <li class="sketch-history-item">
                  <a
                    href={
                      isCurrent
                        ? sketchPath(sketch.ownerLogin, sketch.id)
                        : sketchRevisionPath(
                            sketch.ownerLogin,
                            sketch.id,
                            entry.revision
                          )
                    }
                    aria-current={viewing ? "true" : undefined}
                  >
                    <time datetime={new Date(entry.createdAt).toISOString()}>
                      {formatTime(entry.createdAt)}
                    </time>
                    <code>{entry.revision.slice(0, 7)}</code>
                    {isCurrent && <span class="sketch-history-tag">最新</span>}
                  </a>
                </li>
              );
            })}
          </ol>
        </section>
      )
    }
  </main>
</BaseLayout>

<script>
  import { SketchActions } from "../../scripts/sketch/sketch-actions";
  import { SketchView } from "../../scripts/sketch/sketch-view";

  const root = document.querySelector<HTMLElement>(".sketch-page");
  if (root) {
    new SketchView(root);

    // 実行と独立に走らせる。セッションの往復を待つ間、閲覧は止めない。
    const actions = root.querySelector<HTMLElement>("#sketch-actions");
    if (actions) void new SketchActions(root, actions).refresh();
  }
</script>

<style>
  .sketch-page {
    max-width: 60rem;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
  }

  h1 {
    margin: 0;
    font-size: 1.75rem;
  }

  .sketch-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
    margin: 0.5rem 0 0;
    color: var(--muted);
    font-size: 0.875rem;
  }

  .sketch-author {
    display: inline-flex;
    gap: 0.375rem;
    align-items: center;
    color: inherit;
  }

  .sketch-avatar {
    border-radius: 50%;
  }

  .sketch-meta a,
  .sketch-description a,
  .sketch-lineage a {
    color: var(--accent);
  }

  .sketch-lineage {
    margin: 0.5rem 0 0;
    color: var(--muted);
    font-size: 0.875rem;
  }

  .sketch-description {
    margin: 1rem 0 0;
    white-space: pre-wrap;
  }

  /* タグ (Phase 5)。同じ主題の作品へ渡る道。 */
  .sketch-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .sketch-tags a {
    display: inline-block;
    padding: 0.125rem 0.625rem;
    border: 1px solid color-mix(in srgb, var(--muted) 35%, transparent);
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.8125rem;
    text-decoration: none;
    /* 日本語のタグは長くなりうる。1 つが横に伸びても行が崩れないようにする。 */
    overflow-wrap: anywhere;
  }

  .sketch-tags a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* 限定公開が private ではないことの明示 (要件 3.4)。 */
  .sketch-warning {
    margin: 1rem 0 0;
    padding: 0.5rem 0.75rem;
    border-left: 3px solid var(--accent);
    color: var(--muted);
    font-size: 0.875rem;
  }

  /* 過去の版を見ていることの明示 (Phase 4-1)。限定公開の注意書きと同じ形にして、
     「今見ているものが普段と違う」ことを 1 種類の見た目で伝える。 */
  .sketch-past {
    margin: 1rem 0 0;
    padding: 0.5rem 0.75rem;
    border-left: 3px solid var(--accent);
    color: var(--muted);
    font-size: 0.875rem;
  }

  .sketch-past a {
    color: var(--accent);
  }

  .sketch-notice {
    margin: 1.5rem 0 0;
    color: var(--muted);
  }

  .sketch-history {
    margin: 2rem 0 0;
  }

  .sketch-history-heading {
    margin: 0;
    font-size: 1rem;
  }

  .sketch-history-note {
    margin: 0.25rem 0 0.75rem;
    color: var(--muted);
    font-size: 0.8125rem;
  }

  .sketch-history-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .sketch-history-item a {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
    padding: 0.375rem 0.5rem;
    border-radius: 0.375rem;
    color: inherit;
    font-size: 0.875rem;
    text-decoration: none;
  }

  .sketch-history-item a:hover {
    background: color-mix(in srgb, var(--fg) 6%, transparent);
  }

  /* 今見ている版。色だけに頼らず、印としても読めるよう左に線を引く。 */
  .sketch-history-item a[aria-current] {
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    box-shadow: inset 3px 0 0 var(--accent);
  }

  .sketch-history-item code {
    color: var(--muted);
    font-size: 0.8125rem;
  }

  .sketch-history-tag {
    color: var(--accent);
    font-size: 0.75rem;
  }

  /* 実行面。作品が縦横どちらでも収まるよう 16:10 の枠に収める。 */
  .sketch-stage {
    position: relative;
    aspect-ratio: 16 / 10;
    margin: 1.5rem 0 0;
    overflow: hidden;
    border-radius: 0.5rem;
    background: #000;
  }

  .sketch-stage :global(.preview-frame) {
    width: 100%;
    height: 100%;
    border: none;
  }

  .sketch-code {
    margin: 2rem 0 0;
  }

  .sketch-code-heading {
    margin: 0 0 0.75rem;
    font-size: 1rem;
  }

  /* 追従している印 (Phase 4-2)。**繋がっているときだけ**出す。
     色だけに頼らず、点と文字の両方で読めるようにする。 */
  .sketch-live {
    display: none;
    gap: 0.375rem;
    align-items: center;
    color: var(--accent);
  }

  .sketch-page[data-live-state="live"] .sketch-live {
    display: inline-flex;
  }

  .sketch-live::before {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: currentcolor;
    content: "";
  }
</style>
