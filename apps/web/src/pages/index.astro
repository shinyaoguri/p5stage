---
/**
 * トップページ (Phase 5)。公開作品の新着ギャラリー。
 *
 * ログイン無しで作品を発見できることが Phase 5 の完了条件の入口。一覧は D1 だけで
 * 引き、中身 (R2) には触れない — カードに要るのはメタデータとサムネイルの URL だけ。
 */
import { env } from "cloudflare:workers";

import SketchGrid from "../components/SketchGrid.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { assetsOrigin } from "../lib/assets/delivery-origin";
import { toSketchCards } from "../lib/sketches/card";
import { listPublicSketches } from "../lib/sketches/store";

export const prerender = false;

/** 新着に並べる件数。ページングは Phase 5 の一覧 UI を広げるときに決める。 */
const HOME_LIST_LIMIT = 24;

const sketches = await listPublicSketches(env.DB, HOME_LIST_LIMIT);

/**
 * サムネイルの配信オリジン (ADR 0014)。`/t/` は配信ホストからしか出ないので
 * 絶対 URL にする。オリジン解決は null 安全なものを使い、未設定でも一覧自体は出す
 * (絵だけ諦めてプレースホルダを出す) ので、作品ページと違いここでは設定エラーを
 * ページに出さない。
 */
const cards = toSketchCards(sketches, assetsOrigin());

// 公開作品しか出さないのでエッジに載せる (作品ページの公開時と同じ)。
Astro.response.headers.set("Cache-Control", "public, max-age=0, s-maxage=60");
---

<BaseLayout title="p5stage">
  <main>
    <header class="hero">
      <h1>p5stage</h1>
      <p class="lead">p5.js スケッチの開発・共有プラットフォーム</p>
      <a class="cta" href="/edit">スケッチを作る</a>
    </header>

    <section class="latest" aria-labelledby="latest-heading">
      <h2 id="latest-heading">新着の作品</h2>
      {
        cards.length === 0 ? (
          <p class="empty">公開された作品はまだありません。</p>
        ) : (
          <SketchGrid cards={cards} />
        )
      }
    </section>
  </main>
</BaseLayout>

<style>
  main {
    max-width: 60rem;
    margin: 0 auto;
    padding: 3rem 1.5rem 4rem;
  }

  .hero {
    margin-bottom: 3rem;
  }

  h1 {
    margin: 0;
    font-size: 2.5rem;
    letter-spacing: 0.02em;
  }

  .lead {
    margin: 0.5rem 0 1.5rem;
    font-size: 1.125rem;
  }

  .cta {
    display: inline-block;
    padding: 0.5rem 1.25rem;
    border-radius: 0.375rem;
    background: var(--accent);
    color: #fff;
    text-decoration: none;
    font-weight: 600;
  }

  h2 {
    margin: 0 0 1rem;
    font-size: 1.25rem;
  }

  .empty {
    color: var(--muted);
  }
</style>
