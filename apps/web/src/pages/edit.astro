---
import { OriginConfigError, resolveOrigins } from "@p5stage/shared";
import { env } from "cloudflare:workers";

import BaseLayout from "../layouts/BaseLayout.astro";

// 実行環境のオリジンは実行時に決まるので、このページは静的化しない。
export const prerender = false;

let previewOrigin: string | null = null;
let originError: string | null = null;
try {
  previewOrigin = resolveOrigins({
    web: Astro.url.origin,
    preview: env.PUBLIC_PREVIEW_ORIGIN,
  }).preview;
} catch (error) {
  if (!(error instanceof OriginConfigError)) throw error;
  originError = error.message;
}
---

<BaseLayout title="エディタ | p5stage">
  {
    originError !== null ? (
      <p class="error">実行環境のオリジン設定が不正です: {originError}</p>
    ) : (
      <div id="editor-root" data-preview-origin={previewOrigin}>
        {/* 実行キャンバス。エディタはこの上に透過で重なる (要件 3.1)。 */}
        <div id="stage" />
        <div id="editor" />

        <div id="file-tabs" />

        {/* ステータスは長さが変わるので左端に置く (伸びてもボタンが動かない)。
            下書きの状態は実行の状態とは別に出す (片方がもう片方を消さない)。 */}
        <div class="chrome">
          <span id="draft-status" class="status draft-status" role="status" />
          <span id="status" class="status" role="status" />
          <button id="run" type="button">
            実行 (⌘/Ctrl+Enter)
          </button>
          <button id="stop" type="button">
            停止
          </button>
          <button id="new" type="button">
            新規
          </button>
          <div id="settings" />
        </div>

        <div id="console" />
      </div>
    )
  }
</BaseLayout>

<script>
  import {
    DEFAULT_SKETCH_FILES,
    isTransitionId,
    type TransitionRequest,
  } from "@p5stage/shared";

  import { DraftSaver, loadDraft } from "../scripts/draft/draft-store";
  import { CodeEditor } from "../scripts/editor/code-editor";
  import { ConsolePanel } from "../scripts/editor/console-panel";
  import { FileTabs } from "../scripts/editor/file-tabs";
  import { isRunShortcut } from "../scripts/editor/run-shortcut";
  import { PreviewHost } from "../scripts/preview-host";
  import { applyCssVariables } from "../scripts/settings/css-variables";
  import { SettingsPanel } from "../scripts/settings/settings-panel";
  import {
    SettingsSaver,
    loadSettings,
  } from "../scripts/settings/settings-store";

  const root = document.getElementById("editor-root");
  const previewOrigin = root?.dataset.previewOrigin;
  const editorHost = document.getElementById("editor");
  const tabsHost = document.getElementById("file-tabs");
  const stage = document.getElementById("stage");
  const consoleHost = document.getElementById("console");
  const settingsHost = document.getElementById("settings");
  const status = document.getElementById("status");
  const draftStatus = document.getElementById("draft-status");

  /**
   * 下書きの時刻。「いつの続きか」が分かればよいので月日と分まで。
   * ここは実行ボタンと同じ行に出るので、年を出して折り返させない。
   */
  const formatSavedAt = (savedAt: number) =>
    new Date(savedAt).toLocaleString("ja-JP", {
      month: "numeric",
      day: "numeric",
      hour: "2-digit",
      minute: "2-digit",
    });

  const init = async () => {
    if (
      !root ||
      !previewOrigin ||
      !editorHost ||
      !tabsHost ||
      !stage ||
      !consoleHost ||
      !settingsHost
    ) {
      return;
    }

    const setStatus = (text: string) => {
      if (status) status.textContent = text;
    };
    const setDraftStatus = (text: string) => {
      if (draftStatus) draftStatus.textContent = text;
    };

    // エディタを作る前に設定と下書きを読む。後から当てると、初回の描画だけ
    // 既定の見た目・既定のテンプレートが見えてから切り替わる。
    // どちらも相手を待つ理由が無いので同時に読む。
    const [initialSettings, draft] = await Promise.all([
      loadSettings(),
      loadDraft(),
    ]);
    let settings = initialSettings;
    applyCssVariables(settings);
    if (draft !== null) {
      setDraftStatus(`下書きを復元しました (${formatSavedAt(draft.savedAt)})`);
    }

    const consolePanel = new ConsolePanel(consoleHost);

    const host = new PreviewHost(stage, {
      previewOrigin,
      onReady: () => setStatus("実行環境に接続しました"),
      onRendered: (gen) => setStatus(`実行 #${gen}`),
      onError: (message) => setStatus(message),
      onConsole: (level, message, timestamp) =>
        consolePanel.add(level, message, timestamp),
    });

    // 演出は「なし」も選べるので、id が既知のときだけ指定として組み立てる。
    const selectedTransition = (): TransitionRequest | null =>
      isTransitionId(settings.transitionId)
        ? { id: settings.transitionId, durationMs: settings.transitionMs }
        : null;

    const run = () => {
      consolePanel.clear();
      host.run(editor.getFiles(), selectedTransition());
    };

    const draftSaver = new DraftSaver({
      onSaved: (saved) =>
        setDraftStatus(`下書きを保存 (${formatSavedAt(saved.savedAt)})`),
      // 保存できない環境 (IndexedDB が無効・容量超過) は編集を止める理由には
      // ならないが、黙って失われるのは困るので出したままにする。
      onError: () => setDraftStatus("下書きを保存できません"),
    });

    // 下書きは内容の変更 (onChange) だけでなく、ファイルの増減・改名・
    // 開いているファイルの移動 (onFilesChanged) でも書く。
    const saveDraft = () =>
      draftSaver.save(editor.getFiles(), editor.activeFile);

    const editor = new CodeEditor(editorHost, {
      files: draft?.files ?? DEFAULT_SKETCH_FILES,
      activeFile: draft?.activeFile ?? "sketch.js",
      settings,
      onRun: run,
      onChange: saveDraft,
      onFilesChanged: (fileNames, activeFile) => {
        tabs.render(fileNames, activeFile);
        saveDraft();
      },
    });

    const settingsSaver = new SettingsSaver();
    new SettingsPanel(settingsHost, settings, {
      onChange: (next) => {
        settings = next;
        applyCssVariables(next);
        editor.applySettings(next);
        settingsSaver.save(next);
      },
    });

    // 間引いた書き込みがページを離れるときに残らないようにする。モバイルでは
    // pagehide が来ないまま破棄されることがあるので、隠れた時点でも書く。
    const flushAll = () => {
      void settingsSaver.flush();
      void draftSaver.flush();
    };
    window.addEventListener("pagehide", flushAll);
    document.addEventListener("visibilitychange", () => {
      if (document.visibilityState === "hidden") flushAll();
    });

    const tabs = new FileTabs(tabsHost, {
      onSelect: (name, { moveFocusToEditor }) => {
        editor.open(name);
        if (moveFocusToEditor) editor.focus();
      },
      onAdd: (name) => {
        editor.addFile(name);
        editor.focus();
      },
      onRename: (name, newName) => {
        editor.renameFile(name, newName);
        editor.focus();
      },
      onRemove: (name) => {
        // 削除は取り消せない (下書きも削除後の姿で上書きされる)。
        // 中身があるときだけ確認する。
        const content = editor.getFiles()[name] ?? "";
        if (
          content.trim() !== "" &&
          !window.confirm(`${name} を削除します。元に戻せません。`)
        ) {
          return;
        }
        editor.removeFile(name);
        editor.focus();
      },
      onError: setStatus,
    });
    tabs.render(editor.fileNames, editor.activeFile);

    document.getElementById("run")?.addEventListener("click", run);
    document.getElementById("stop")?.addEventListener("click", () => {
      host.stop();
      setStatus("停止しました");
    });

    // 下書きは黙って復元される。戻る道が無いと前回の続きから抜けられないので、
    // 破棄して最初から始める口をここに置く。
    document.getElementById("new")?.addEventListener("click", () => {
      if (!window.confirm("編集中の内容を破棄して新しいスケッチを始めます。")) {
        return;
      }
      // 差し替えで onFilesChanged が走り保存が予約される。その予約ごと
      // 捨てるため、破棄はファイルを入れ替えた**後**に行う。
      editor.setFiles(DEFAULT_SKETCH_FILES, "sketch.js");
      void draftSaver.clear();
      setDraftStatus("下書きを破棄しました");
      run();
      editor.focus();
    });

    // エディタの外 (ボタンやファイル選択) にフォーカスがあるときの ⌘/Ctrl+Enter。
    // エディタ内の keydown は CodeEditor 側が拾って伝播を止めるので二重に走らない。
    window.addEventListener("keydown", (event) => {
      if (!isRunShortcut(event)) return;
      if (editorHost.contains(event.target as Node | null)) return;
      event.preventDefault();
      run();
    });

    run();
    editor.focus();
  };

  void init();
</script>

<style>
  #editor-root {
    position: fixed;
    inset: 0;
    /* スケッチが描き切らない領域は黒。透過エディタの下地でもある。 */
    background: #000;
  }

  #stage {
    position: absolute;
    inset: 0;
  }

  #stage :global(.preview-frame) {
    width: 100%;
    height: 100%;
    border: none;
  }

  /* 透過エディタ。スケッチの上に重ね、端はスケッチが見えるよう余白を空ける。 */
  #editor {
    position: absolute;
    z-index: 10;
    inset: max(3.5rem, 2rem) max(0.5rem, 2rem) max(0.5rem, 2rem);
  }

  .chrome {
    position: absolute;
    z-index: 20;
    top: 0;
    right: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
    padding: 0.5rem 0.75rem;
    color: #fff;
    font-size: 0.8125rem;
    text-shadow: 0 0 3px #000;
  }

  /* ファイルタブ。左上に置き、右上の実行ボタン群とは重ならない幅に収める。
     中身の見た目は styles/file-tabs.css (JS が組み立てる DOM に届かせるため)。 */
  #file-tabs {
    position: absolute;
    z-index: 20;
    top: 0.5rem;
    left: 0.75rem;
    max-width: calc(100% - 22rem);
  }

  .chrome button {
    padding: 0.25rem 0.5rem;
    border: 1px solid rgb(255 255 255 / 0.25);
    border-radius: 0.25rem;
    background: rgb(0 0 0 / 0.4);
    color: inherit;
    font: inherit;
  }

  .chrome button {
    cursor: pointer;
  }

  .chrome button:hover {
    background: rgb(255 255 255 / 0.15);
  }

  .status {
    color: rgb(255 255 255 / 0.7);
  }

  /* 下書きの状態は常時出たままになるので、実行の状態より控えめにする。 */
  .draft-status {
    color: rgb(255 255 255 / 0.5);
  }

  /* コンソール。中身の見た目は styles/console-panel.css (JS が組み立てる DOM に
     届かせるため)。ここは置き場所だけを決める。 */
  #console {
    position: absolute;
    z-index: 20;
    right: 0.5rem;
    bottom: 0.5rem;
    max-width: calc(100% - 1rem);
  }

  .error {
    padding: 2rem;
    color: var(--accent);
  }
</style>
