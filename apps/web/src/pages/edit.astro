---
import { OriginConfigError, resolveOrigins } from "@p5stage/shared";
import { env } from "cloudflare:workers";

import BaseLayout from "../layouts/BaseLayout.astro";

// 実行環境のオリジンは実行時に決まるので、このページは静的化しない。
export const prerender = false;

let previewOrigin: string | null = null;
let originError: string | null = null;
try {
  previewOrigin = resolveOrigins({
    web: Astro.url.origin,
    preview: env.PUBLIC_PREVIEW_ORIGIN,
  }).preview;
} catch (error) {
  if (!(error instanceof OriginConfigError)) throw error;
  originError = error.message;
}
---

<BaseLayout title="エディタ | p5stage">
  {
    originError !== null ? (
      <p class="error">実行環境のオリジン設定が不正です: {originError}</p>
    ) : (
      <div id="editor-root" data-preview-origin={previewOrigin}>
        {/* 実行キャンバス。エディタはこの上に透過で重なる (要件 3.1)。 */}
        <div id="stage" />
        <div id="editor" />

        {/*
          ファイルの切り替えは 1-3 でタブに差し替える。ここでは 1-1 の
          暫定 UI をそのまま引き継いでいる (Issue #11)。
        */}
        <div class="chrome">
          <label class="file-picker">
            ファイル
            <select id="file-select" />
          </label>
          <button id="run" type="button">
            実行 (⌘/Ctrl+Enter)
          </button>
          <button id="stop" type="button">
            停止
          </button>
          <span id="status" class="status" role="status" />
        </div>

        <ul id="console" class="console" role="log" aria-live="polite" />
      </div>
    )
  }
</BaseLayout>

<script>
  import { DEFAULT_SKETCH_FILES } from "@p5stage/shared";

  import { CodeEditor } from "../scripts/editor/code-editor";
  import { isRunShortcut } from "../scripts/editor/run-shortcut";
  import { PreviewHost } from "../scripts/preview-host";

  const root = document.getElementById("editor-root");
  const previewOrigin = root?.dataset.previewOrigin;
  const editorHost = document.getElementById("editor");
  const fileSelect = document.getElementById(
    "file-select"
  ) as HTMLSelectElement | null;
  const stage = document.getElementById("stage");
  const consoleList = document.getElementById("console");
  const status = document.getElementById("status");

  if (
    root &&
    previewOrigin &&
    editorHost &&
    fileSelect &&
    stage &&
    consoleList
  ) {
    const setStatus = (text: string) => {
      if (status) status.textContent = text;
    };

    const host = new PreviewHost(stage, {
      previewOrigin,
      onReady: () => setStatus("実行環境に接続しました"),
      onRendered: (gen) => setStatus(`実行 #${gen}`),
      onError: (message) => setStatus(message),
      onConsole: (level, message) => {
        const item = document.createElement("li");
        item.className = `console-line console-${level}`;
        item.textContent = message;
        consoleList.appendChild(item);
        while (consoleList.childElementCount > 100) {
          consoleList.firstElementChild?.remove();
        }
        consoleList.scrollTop = consoleList.scrollHeight;
      },
    });

    const run = () => {
      consoleList.replaceChildren();
      host.run(editor.getFiles());
    };

    const editor = new CodeEditor(editorHost, {
      files: DEFAULT_SKETCH_FILES,
      activeFile: "sketch.js",
      onRun: run,
    });

    for (const name of editor.fileNames) {
      const option = document.createElement("option");
      option.value = name;
      option.textContent = name;
      option.selected = name === editor.activeFile;
      fileSelect.appendChild(option);
    }

    fileSelect.addEventListener("change", () => {
      editor.open(fileSelect.value);
      editor.focus();
    });

    document.getElementById("run")?.addEventListener("click", run);
    document.getElementById("stop")?.addEventListener("click", () => {
      host.stop();
      setStatus("停止しました");
    });

    // エディタの外 (ボタンやファイル選択) にフォーカスがあるときの ⌘/Ctrl+Enter。
    // エディタ内の keydown は CodeEditor 側が拾って伝播を止めるので二重に走らない。
    window.addEventListener("keydown", (event) => {
      if (!isRunShortcut(event)) return;
      if (editorHost.contains(event.target as Node | null)) return;
      event.preventDefault();
      run();
    });

    run();
    editor.focus();
  }
</script>

<style>
  #editor-root {
    position: fixed;
    inset: 0;
    /* スケッチが描き切らない領域は黒。透過エディタの下地でもある。 */
    background: #000;
  }

  #stage {
    position: absolute;
    inset: 0;
  }

  #stage :global(.preview-frame) {
    width: 100%;
    height: 100%;
    border: none;
  }

  /* 透過エディタ。スケッチの上に重ね、端はスケッチが見えるよう余白を空ける。 */
  #editor {
    position: absolute;
    z-index: 10;
    inset: max(3.5rem, 2rem) max(0.5rem, 2rem) max(0.5rem, 2rem);
  }

  .chrome {
    position: absolute;
    z-index: 20;
    top: 0;
    right: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
    padding: 0.5rem 0.75rem;
    color: #fff;
    font-size: 0.8125rem;
    text-shadow: 0 0 3px #000;
  }

  .file-picker {
    display: flex;
    gap: 0.375rem;
    align-items: center;
  }

  .chrome select,
  .chrome button {
    padding: 0.25rem 0.5rem;
    border: 1px solid rgb(255 255 255 / 0.25);
    border-radius: 0.25rem;
    background: rgb(0 0 0 / 0.4);
    color: inherit;
    font: inherit;
  }

  .chrome button {
    cursor: pointer;
  }

  .chrome button:hover {
    background: rgb(255 255 255 / 0.15);
  }

  .status {
    color: rgb(255 255 255 / 0.7);
  }

  /* コンソール。整えるのは 1-4 (console パネル) の担当で、ここは最小限。 */
  .console {
    position: absolute;
    z-index: 20;
    right: 0.5rem;
    bottom: 0.5rem;
    max-width: min(28rem, 50vw);
    max-height: 30vh;
    margin: 0;
    padding: 0.5rem;
    overflow-y: auto;
    border-radius: 0.25rem;
    background: rgb(0 0 0 / 0.5);
    color: rgb(255 255 255 / 0.75);
    list-style: none;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.75rem;
    backdrop-filter: blur(8px);
  }

  .console:empty {
    display: none;
  }

  .console-line {
    white-space: pre-wrap;
    word-break: break-word;
  }

  .console-warn {
    color: #ffcc66;
  }

  .console-error {
    color: #ff8095;
  }

  .error {
    padding: 2rem;
    color: var(--accent);
  }
</style>
