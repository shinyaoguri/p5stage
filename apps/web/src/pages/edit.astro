---
import { OriginConfigError, resolveOrigins } from "@p5stage/shared";
import { env } from "cloudflare:workers";

import BaseLayout from "../layouts/BaseLayout.astro";
import { configuredAssetsOrigin } from "../lib/assets/delivery-origin";
// クロームのトークン。下の scoped style が引くので、スクリプトの読み込みを
// 待たずに当たるようページ側で読む (パネル群の CSS は各スクリプトが持つ)。
import "../styles/editor-chrome.css";

// 実行環境のオリジンは実行時に決まるので、このページは静的化しない。
export const prerender = false;

let previewOrigin: string | null = null;
let assetsOrigin: string | null = null;
let originError: string | null = null;
try {
  const origins = resolveOrigins({
    web: Astro.url.origin,
    preview: env.PUBLIC_PREVIEW_ORIGIN,
    assets: configuredAssetsOrigin(),
  });
  previewOrigin = origins.preview;
  assetsOrigin = origins.assets;
} catch (error) {
  if (!(error instanceof OriginConfigError)) throw error;
  originError = error.message;
}
---

<BaseLayout title="エディタ | p5stage">
  {
    originError !== null ? (
      <p class="error">実行環境のオリジン設定が不正です: {originError}</p>
    ) : (
      <div
        id="editor-root"
        data-preview-origin={previewOrigin}
        data-assets-origin={assetsOrigin}
      >
        {/* 実行キャンバス。エディタはこの上に透過で重なる (要件 3.1)。 */}
        <div id="stage" />
        <div id="editor" />

        <div id="file-tabs" />

        {/* 実行ボタンと作品の名前。編集中に最も多く押す操作なので、右上の操作列に
            混ぜず画面上部中央に単独で置く (#41 の 3)。 */}
        <div id="project-bar" />

        {/* ステータスは長さが変わるので左端に置く (伸びてもボタンが動かない)。
            下書きの状態は実行の状態とは別に出す (片方がもう片方を消さない)。

            ここに残るのは**今そうである状態**だけ (#41 の 5)。もう終わった出来事の
            報告はトースト (scripts/ui/toast.ts) へ移した — 行が 1 本しか無いので、
            混ぜると後から来た知らせが前のものを消していた。

            並びは「文字 → アイコン」。文字が続く左側に寄せて、アイコン列が右端で
            途切れないようにする。 */}
        <div class="chrome">
          <span id="draft-status" class="status draft-status" role="status" />
          <span id="status" class="status" role="status" />
          <div id="save-controls" />
          <div id="new-controls" />
          {/* 既にある自分の Gist から始める道 (Phase 2-6)。 */}
          <div id="adopt-controls" />
          <div id="settings" />
          <div id="account" />
        </div>

        <div id="console" />
      </div>
    )
  }
</BaseLayout>

<script>
  import {
    DEFAULT_SKETCH_FILES,
    assetUrlsForFiles,
    isTransitionId,
    readAssetManifest,
    type TransitionRequest,
  } from "@p5stage/shared";

  import { AccountPanel } from "../scripts/auth/account-panel";
  import { DraftSaver, loadDraft } from "../scripts/draft/draft-store";
  import { CodeEditor } from "../scripts/editor/code-editor";
  import { ConsolePanel } from "../scripts/editor/console-panel";
  import { FileTabs } from "../scripts/editor/file-tabs";
  import { isRunShortcut } from "../scripts/editor/run-shortcut";
  import { PreviewHost } from "../scripts/preview-host";
  import { AdoptPanel } from "../scripts/sketch/adopt-panel";
  import {
    adoptGist,
    detachSketchGist,
    GistAdoptError,
  } from "../scripts/sketch/gist-adopt";
  import {
    chooseStartingPoint,
    clearSketchIdInUrl,
    loadSketch,
    preferredActiveFile,
    showSketchIdInUrl,
    SketchLoadError,
    sketchIdFromUrl,
  } from "../scripts/sketch/open-sketch";
  import { ProjectBar } from "../scripts/editor/project-bar";
  import { generateProjectName } from "../scripts/sketch/project-name";
  import { SavePanel } from "../scripts/sketch/save-panel";
  import { SketchSaver } from "../scripts/sketch/sketch-saver";
  import { TitleSaver } from "../scripts/sketch/title-saver";
  import { applyCssVariables } from "../scripts/settings/css-variables";
  import { SettingsPanel } from "../scripts/settings/settings-panel";
  import { showToast } from "../scripts/ui/toast";
  import { makeToolbarButton } from "../scripts/ui/toolbar-button";
  import {
    SettingsSaver,
    loadSettings,
  } from "../scripts/settings/settings-store";

  const root = document.getElementById("editor-root");
  const previewOrigin = root?.dataset.previewOrigin;
  // アセットの配信オリジン。設定が無い構成でもエディタは動く (アセットだけ
  // 解決されない) ので、実行を止める条件には入れない。
  const assetsOrigin = root?.dataset.assetsOrigin ?? null;
  const editorHost = document.getElementById("editor");
  const tabsHost = document.getElementById("file-tabs");
  const stage = document.getElementById("stage");
  const consoleHost = document.getElementById("console");
  const settingsHost = document.getElementById("settings");
  const status = document.getElementById("status");
  const draftStatus = document.getElementById("draft-status");
  const saveHost = document.getElementById("save-controls");
  const adoptHost = document.getElementById("adopt-controls");
  const newHost = document.getElementById("new-controls");
  const projectBarHost = document.getElementById("project-bar");

  /**
   * 下書きの時刻。「いつの続きか」が分かればよいので月日と分まで。
   * ここは実行ボタンと同じ行に出るので、年を出して折り返させない。
   */
  const formatSavedAt = (savedAt: number) =>
    new Date(savedAt).toLocaleString("ja-JP", {
      month: "numeric",
      day: "numeric",
      hour: "2-digit",
      minute: "2-digit",
    });

  const init = async () => {
    if (
      !root ||
      !previewOrigin ||
      !editorHost ||
      !tabsHost ||
      !stage ||
      !consoleHost ||
      !settingsHost ||
      !saveHost ||
      !adoptHost ||
      !projectBarHost
    ) {
      return;
    }

    const setStatus = (text: string) => {
      if (status) status.textContent = text;
    };
    /**
     * 下書きまわりの**状態**を出す (#41 の 5)。
     *
     * 出来事の報告はここではなくトーストへ渡す。ここに残すのは「消えると気付けない
     * まま書き続けることになる」もの — 直すまで続く条件と、下書きが今どうなって
     * いるか。
     */
    const setDraftStatus = (text: string) => {
      if (draftStatus) draftStatus.textContent = text;
    };

    // エディタを作る前に設定・下書き・(URL が作品を指していれば) 保存済みの中身を
    // 読む。後から当てると、初回の描画だけ既定の見た目・既定のテンプレートが
    // 見えてから切り替わる。互いに待つ理由が無いので同時に読む。
    const sketchId = sketchIdFromUrl(window.location.search);
    let loadFailure: string | null = null;
    const [initialSettings, draft, opened] = await Promise.all([
      loadSettings(),
      loadDraft(),
      sketchId === null
        ? Promise.resolve(null)
        : loadSketch(sketchId).catch((error: unknown) => {
            // 読めなくてもエディタは開く。開けないと、手元の下書きにしか
            // 残っていない変更まで触れなくなる。
            loadFailure =
              error instanceof SketchLoadError
                ? error.message
                : "作品を読み込めませんでした";
            return null;
          }),
    ]);
    let settings = initialSettings;
    applyCssVariables(settings);

    const start = chooseStartingPoint({
      sketchId,
      draft,
      remoteFiles: opened?.files ?? null,
    });
    // アセットの一覧が壊れていると保存が通らない (Phase 3-2)。**開いた時点で**
    // 言う — 保存で初めて弾かれると、書いた後に直す羽目になる。
    const manifest = readAssetManifest(start.files);

    // 開いた時点で分かる**直すまで続く条件**。行は 1 本しか無いので重い順に
    // 1 つだけ出す。どれも消えると気付けないまま保存して中身を失うので、
    // トーストには載せない (#41 の 5)。
    if (loadFailure !== null) {
      setDraftStatus(loadFailure);
    } else if (opened !== null && opened.truncated.length > 0) {
      // 中身を取れていないファイルをそのまま保存すると、その中身が失われる。
      setDraftStatus(
        `次のファイルは大きすぎて読み込めませんでした: ${opened.truncated.join(", ")}`
      );
    } else if (manifest !== null && !manifest.ok) {
      setDraftStatus(`${manifest.message} (直すまで保存できません)`);
    }

    // 復元は**もう終わった出来事**なので、上の条件とは別にトーストで言う。
    // 「読み込めなかったので下書きから始めた」は同時に成り立つ状況で、片方が
    // もう片方を消していた頃は後者が見えなかった。
    if (start.source === "draft" && draft !== null) {
      showToast(
        `下書きを復元しました (${formatSavedAt(draft.savedAt)})`,
        "info"
      );
    }

    const consolePanel = new ConsolePanel(consoleHost);

    const host = new PreviewHost(stage, {
      previewOrigin,
      onReady: () => setStatus("実行環境に接続しました"),
      onRendered: (gen) => setStatus(`実行 #${gen}`),
      onError: (message) => setStatus(message),
      onConsole: (level, message, timestamp) =>
        consolePanel.add(level, message, timestamp),
    });

    // 演出は「なし」も選べるので、id が既知のときだけ指定として組み立てる。
    const selectedTransition = (): TransitionRequest | null =>
      isTransitionId(settings.transitionId)
        ? { id: settings.transitionId, durationMs: settings.transitionMs }
        : null;

    const run = () => {
      consolePanel.clear();
      const files = editor.getFiles();
      // 名前 → 配信 URL の解決は本体の仕事 (ADR 0014)。壊れたマニフェストは
      // 空の表になる — その知らせは開いた時点で既に出している。
      host.run(
        files,
        assetUrlsForFiles(files, assetsOrigin),
        selectedTransition()
      );
      // 今の中身を動かしたので、実行後の変更は無くなった (#41 の 3 の青ドット)。
      projectBar.setRunning(true);
      projectBar.setStale(false);
      // 保存済みの作品は、実行のたびに間引いて Gist へ書く (要件 3.2)。
      // リビジョンが「動かした形」の履歴になる。
      saver.scheduleSave();
    };

    const stop = () => {
      host.stop();
      projectBar.setRunning(false);
      setStatus("停止しました");
    };

    /**
     * 最初に出す名前 (#41 の 3)。
     *
     * 中身をどこから採ったか (`start.source`) と揃える。下書きから始めたなら
     * 下書きの名前 — そちらの方が新しい。**どこにも無ければ自動生成**して、
     * 保存前から名前を持たせる。
     */
    const initialName =
      (start.source === "draft" ? draft?.title : null) ??
      opened?.title ??
      draft?.title ??
      generateProjectName();

    const projectBar = new ProjectBar(projectBarHost, {
      onRun: run,
      onStop: stop,
      onRename: (name) => {
        // 保存前の名前は下書きにしか置き場が無い。保存済みなら正本へも書き戻す。
        saveDraft();
        const current = saver.state.sketchId;
        if (current !== null) titleSaver.schedule(current, name);
      },
    });
    projectBar.setName(initialName);

    const draftSaver = new DraftSaver({
      onSaved: (saved) =>
        setDraftStatus(`下書きを保存 (${formatSavedAt(saved.savedAt)})`),
      // 保存できない環境 (IndexedDB が無効・容量超過) は編集を止める理由には
      // ならないが、黙って失われるのは困るので出したままにする。
      onError: () => setDraftStatus("下書きを保存できません"),
    });

    // 下書きは内容の変更 (onChange) だけでなく、ファイルの増減・改名・
    // 開いているファイルの移動 (onFilesChanged) でも書く。名前も一緒に持たせる —
    // 保存前の作品の名前はここにしか置き場が無い (#41 の 3)。
    const saveDraft = () =>
      draftSaver.save(editor.getFiles(), editor.activeFile, {
        sketchId: saver.state.sketchId,
        title: projectBar.name,
      });

    // 開いただけでは下書きを書かない (「復元しました」が出る条件になってしまう)。
    // 自動生成した名前が残るのは、リネームか編集で下書きを書いた後 — どちらも
    // saveDraft を通る。何も触っていない作品の名前は、失っても困るものが無い。

    // 手元 (下書き) と正本 (Gist) の両方に「変わった」を伝える。伝え先が
    // 別々なので、片方だけ呼ぶ経路を作らないようここで束ねる。
    const onEdited = () => {
      saveDraft();
      saver.markDirty();
      // 動かした後に書き換えた = 画面のスケッチは今の中身ではない。
      projectBar.setStale(true);
    };

    const editor = new CodeEditor(editorHost, {
      files: start.files,
      activeFile: start.activeFile,
      settings,
      onRun: run,
      onChange: onEdited,
      onFilesChanged: (fileNames, activeFile) => {
        tabs.render(fileNames, activeFile);
        onEdited();
      },
    });

    // 名前の書き戻し。保存済みの作品だけが対象 (#41 の 3)。
    const titleSaver = new TitleSaver({
      onError: (message) => showToast(message, "error"),
    });

    const savePanel = new SavePanel(saveHost, {
      // 名前は画面上部の入力欄が持つ。初回の保存はそれと公開範囲を束ねて送る。
      onSave: (visibility) =>
        void saver.saveNow(
          visibility === null ? null : { title: projectBar.name, visibility }
        ),
      onDetach: () => void detachCurrentSketch(),
      getTitle: () => projectBar.name,
    });
    const saver = new SketchSaver({
      sketchId,
      getFiles: () => editor.getFiles(),
      onState: (state) => {
        savePanel.render(state);
        // 器ができた時点で、その名前は正本に載っている。開き直しの往復を省く。
        if (state.sketchId !== null && state.status === "saved") {
          titleSaver.markSent(state.sketchId, projectBar.name);
        }
      },
      onCreated: showSketchIdInUrl,
    });

    /**
     * 今の作品を Gist から切り離す (Phase 2-6)。
     *
     * 手元の内容には手を付けない。**正本が外れるだけ**で、続きはそのまま書ける。
     * 次の保存で新しい Gist ができる。
     */
    const detachCurrentSketch = async () => {
      const current = saver.state.sketchId;
      if (current === null) return;
      try {
        await detachSketchGist(current);
      } catch (error) {
        showToast(
          error instanceof GistAdoptError
            ? error.message
            : "切り離せませんでした",
          "error"
        );
        return;
      }
      saver.forgetGist();
      showToast(
        "Gist から切り離しました (保存すると新しい Gist を作ります)",
        "success"
      );
    };

    /**
     * 既にある自分の Gist を取り込んで、その続きから始める (Phase 2-6)。
     *
     * 取り込めた中身は応答に入っているので、開き直さずそのままエディタへ流し込む。
     * 中身の差し替えで自動保存が予約されるので、下書きを捨てるのは**入れ替えた後**
     * (「新規」と同じ順序)。
     */
    new AdoptPanel(adoptHost, {
      onAdopt: async (ref) => {
        let adopted;
        try {
          adopted = await adoptGist(ref);
        } catch (error) {
          return error instanceof GistAdoptError
            ? error.message
            : "取り込めませんでした";
        }

        editor.setFiles(adopted.files, preferredActiveFile(adopted.files));
        void draftSaver.clear();
        saver.adopt(adopted.sketchId, adopted.gist);
        // 名前は Gist の description に入っていたもの。取り込んだ側で作り直すと、
        // 同じ作品が別の名前で並ぶ。読めなかったときだけ新しく振る。
        const adoptedName = adopted.title ?? generateProjectName();
        projectBar.setName(adoptedName);
        titleSaver.markSent(adopted.sketchId, adoptedName);
        showSketchIdInUrl(adopted.sketchId);
        showToast("Gist から取り込みました", "success");
        run();
        editor.focus();
        return null;
      },
    });

    if (sketchId !== null) {
      saver.adopt(sketchId, opened?.gist ?? null);
      // 下書きから始めた = 保存済みの中身より新しい変更が手元にある。
      if (start.source === "draft") saver.markDirty();
    } else {
      savePanel.render(saver.state);
    }

    const settingsSaver = new SettingsSaver();
    new SettingsPanel(settingsHost, settings, {
      onChange: (next) => {
        settings = next;
        applyCssVariables(next);
        editor.applySettings(next);
        settingsSaver.save(next);
      },
    });

    // 間引いた書き込みがページを離れるときに残らないようにする。モバイルでは
    // pagehide が来ないまま破棄されることがあるので、隠れた時点でも書く。
    const flushAll = () => {
      void settingsSaver.flush();
      void draftSaver.flush();
      // Gist への保存は往復が要るので、離脱間際に始めても着地しない。予約は
      // 捨てて未保存のままにする (中身は下書きに残るので次に開けば続けられる)。
      saver.cancelScheduled();
      // 名前も同じ理由で送り切れない。次に開いたときは下書きの名前が出る。
      titleSaver.cancelScheduled();
    };
    window.addEventListener("pagehide", flushAll);
    document.addEventListener("visibilitychange", () => {
      if (document.visibilityState === "hidden") flushAll();
    });

    const tabs = new FileTabs(tabsHost, {
      onSelect: (name, { moveFocusToEditor }) => {
        editor.open(name);
        if (moveFocusToEditor) editor.focus();
      },
      onAdd: (name) => {
        editor.addFile(name);
        editor.focus();
      },
      onRename: (name, newName) => {
        editor.renameFile(name, newName);
        editor.focus();
      },
      onRemove: (name) => {
        // 削除は取り消せない (下書きも削除後の姿で上書きされる)。
        // 中身があるときだけ確認する。
        const content = editor.getFiles()[name] ?? "";
        if (
          content.trim() !== "" &&
          !window.confirm(`${name} を削除します。元に戻せません。`)
        ) {
          return;
        }
        editor.removeFile(name);
        editor.focus();
      },
      // 使えない名前・消せないファイルはトーストで断る (#41 の 5)。実行の状態
      // (`#status`) に出していた頃は、次の実行が来た瞬間に理由が消えていた。
      onError: (message) => showToast(message, "error"),
    });
    tabs.render(editor.fileNames, editor.activeFile);

    // 下書きは黙って復元される。戻る道が無いと前回の続きから抜けられないので、
    // 破棄して最初から始める口をここに置く。
    newHost?.appendChild(
      makeToolbarButton({
        id: "new",
        icon: "newSketch",
        label: "新しいスケッチ",
        onClick: () => {
          if (
            !window.confirm("編集中の内容を破棄して新しいスケッチを始めます。")
          ) {
            return;
          }
          // 差し替えで onFilesChanged が走り保存が予約される。その予約ごと
          // 捨てるため、破棄はファイルを入れ替えた**後**に行う。
          editor.setFiles(DEFAULT_SKETCH_FILES, "sketch.js");
          void draftSaver.clear();
          // 別の作品として始めるので名前も新しく振る (前の名前が残ると、
          // 中身だけ入れ替わった同名の作品になる)。
          projectBar.setName(generateProjectName());
          // 開いていた作品から切り離す。ここを忘れると、新しく書き始めた内容が
          // 前の作品の Gist を上書きする。
          saver.detach();
          clearSketchIdInUrl();
          showToast("下書きを破棄しました", "info");
          run();
          editor.focus();
        },
      })
    );

    // エディタの外 (ボタンやファイル選択) にフォーカスがあるときの ⌘/Ctrl+Enter。
    // エディタ内の keydown は CodeEditor 側が拾って伝播を止めるので二重に走らない。
    window.addEventListener("keydown", (event) => {
      if (!isRunShortcut(event)) return;
      if (editorHost.contains(event.target as Node | null)) return;
      event.preventDefault();
      run();
    });

    run();
    editor.focus();
  };

  /**
   * ログイン状態はエディタの初期化と独立に描く。
   *
   * 実行環境のオリジン設定が壊れていてもログインの導線は出したいし、
   * 逆にログイン状態の取得に失敗してもエディタは動くべきなので、互いに待たない。
   */
  const initAccount = async () => {
    const accountHost = document.getElementById("account");
    if (!accountHost) return;

    const panel = new AccountPanel(accountHost);
    // 認可から戻った直後の失敗はここで拾う (成功時は何も出さない)。もう一度
    // ログインすれば済む出来事なので、パネルに残さずトーストで言う (#41 の 5)。
    const failure = AccountPanel.takeFailureMessage();
    if (failure !== null) showToast(failure, "error");
    await panel.refresh();
  };

  void init();
  void initAccount();
</script>

<style>
  #editor-root {
    position: fixed;
    inset: 0;
    /* スケッチが描き切らない領域は黒。透過エディタの下地でもある。 */
    background: #000;
  }

  #stage {
    position: absolute;
    inset: 0;
  }

  #stage :global(.preview-frame) {
    width: 100%;
    height: 100%;
    border: none;
  }

  /* 透過エディタ。スケッチの上に重ね、端はスケッチが見えるよう余白を空ける。
     左右と下は共通の余白 (styles/editor-chrome.css)。上だけは操作列とファイルタブの
     分を空ける。アイコン列になった今 (#41 の 2-3)、必要な高さは 28px のボタンと
     上下の余白で 2.75rem に収まる (テキストボタンが折り返していた頃は 3.5rem 要った)。 */
  #editor {
    position: absolute;
    z-index: 10;
    inset: max(2.75rem, var(--editor-padding))
