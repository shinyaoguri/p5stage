---
/**
 * 作品の一覧 (Phase 5)。トップページの新着と作者のページが同じ形で並べる。
 *
 * 中身は `toSketchCards` が組み立て済みの値だけ。ここは見た目に専念する。
 */
import type { SketchCard } from "../lib/sketches/card";

interface Props {
  cards: readonly SketchCard[];
}

const { cards } = Astro.props;

const formatTime = (value: number): string =>
  new Date(value).toLocaleString("ja-JP", {
    year: "numeric",
    month: "numeric",
    day: "numeric",
    hour: "2-digit",
    minute: "2-digit",
  });
---

<ul class="grid">
  {
    cards.map((card) => (
      <li>
        <a class="card" href={card.href}>
          {card.thumbnailUrl !== null ? (
            <img class="thumb" src={card.thumbnailUrl} alt="" loading="lazy" />
          ) : (
            <div class="thumb thumb-placeholder" aria-hidden="true" />
          )}
          <h3 class="card-title">{card.title}</h3>
          <p class="card-meta">
            <span class="card-author">
              {card.ownerAvatarUrl !== null && (
                <img
                  class="card-avatar"
                  src={card.ownerAvatarUrl}
                  alt=""
                  width="20"
                  height="20"
                  loading="lazy"
                />
              )}
              {card.ownerLogin}
            </span>
            <time datetime={new Date(card.updatedAt).toISOString()}>
              {formatTime(card.updatedAt)}
            </time>
          </p>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .card {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  /* 絵の比率は撮る側の canvas 次第 (ADR 0019) なので、カードでは 4:3 に切り揃える。 */
  .thumb {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 0.5rem;
    background: color-mix(in srgb, var(--muted) 12%, transparent);
  }

  .card-title {
    margin: 0.625rem 0 0;
    font-size: 1rem;
    line-height: 1.4;
    overflow-wrap: anywhere;
  }

  .card:hover .card-title {
    color: var(--accent);
  }

  .card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    align-items: center;
    margin: 0.25rem 0 0;
    color: var(--muted);
    font-size: 0.8125rem;
  }

  .card-author {
    display: inline-flex;
    gap: 0.375rem;
    align-items: center;
  }

  .card-avatar {
    border-radius: 50%;
  }
</style>
