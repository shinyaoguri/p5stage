{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "p5stage-preview",
  "main": "./src/index.ts",
  "compatibility_date": "2026-08-11",
  "assets": {
    "binding": "ASSETS",
    // vite build の出力 (client/ をビルドしたもの)。
    "directory": "./dist/client",
    // すべてのリクエストを Worker に通してセキュリティヘッダを付ける。
    "run_worker_first": true,
  },
  "routes": [
    {
      "pattern": "preview.p5stage.org",
      "custom_domain": true,
    },
  ],
  // PR ごとの確認用 URL (<alias>-p5stage-preview.<subdomain>.workers.dev) を発行する。
  // routes を宣言すると workers_dev は false と推論され、既定ではプレビュー URL も
  // 出なくなるため、明示的に有効化する。workers.dev の常設ルートは開けない。
  "preview_urls": true,
  "observability": {
    "enabled": true,
  },
  "dev": {
    // 本体 (astro dev の 4321) と別オリジンになるよう固定する。
    "port": 8788,
  },
  "vars": {
    // 埋め込みを許可する本体オリジン。
    // ここは本番値。ローカルは .dev.vars で上書きする (.dev.vars.example 参照)。
    "PUBLIC_WEB_ORIGIN": "https://p5stage.org",
  },
}
