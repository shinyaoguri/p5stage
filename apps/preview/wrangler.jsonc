{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "p5stage-preview",
  "main": "./src/index.ts",
  "compatibility_date": "2026-08-11",
  "assets": {
    "binding": "ASSETS",
    "directory": "./public",
    // すべてのリクエストを Worker に通してセキュリティヘッダを付ける。
    "run_worker_first": true,
  },
  "observability": {
    "enabled": true,
  },
  "dev": {
    // 本体 (astro dev の 4321) と別オリジンになるよう固定する。
    "port": 8788,
  },
  "vars": {
    // 埋め込みを許可する本体オリジン。環境ごとに上書きする。
    "PUBLIC_WEB_ORIGIN": "http://localhost:4321",
  },
}
